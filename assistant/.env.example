# Variables del puente de IA (assistant). Copia a .env y rellena los valores. El .env NO se versiona.
#
# Ya NO se usa ninguna cuenta fija de PedidAI (PEDIDAI_EMAIL / PEDIDAI_PASSWORD):
# cada petición llega con el token del usuario y se ejecuta en su nombre.

# URL de la API de PedidAI vista desde el servidor (sin barra final), p. ej. http://localhost:8085/api
PEDIDAI_API_URL=

# Clave de la API de IA (Mistral AI: console.mistral.ai, pago por uso y entrenamiento desactivado)
AI_API_KEY=

# Opcionales
# AI_API_URL=https://api.mistral.ai/v1/chat/completions
# AI_MODEL=mistral-medium-latest
# HOST=127.0.0.1
# PORT=3201
