# Variables de entorno para docker-compose.yml de OrderFlow.
# Copia este archivo a `.env` y rellena los valores reales del entorno.
# El `.env` NO se versiona (está en .gitignore).

# Dominio público donde corre n8n (sin protocolo, sin slash)
N8N_HOST=tudominio.com

# URL completa del editor de n8n (con protocolo, sin slash final)
N8N_EDITOR_BASE_URL=https://tudominio.com/n8n

# URL base para webhooks de n8n (con protocolo y barra final)
WEBHOOK_URL=https://tudominio.com/n8n/
