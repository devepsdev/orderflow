# Variables de entorno para docker-compose.yml de OrderFlow.
# Copia este archivo a `.env` y rellena los valores reales del entorno.
# El `.env` NO se versiona (está en .gitignore).
#
# Estos valores son los REALES de producción — sirven de referencia para
# el siguiente despliegue. NO contienen credenciales, solo URLs públicas.

# Dominio público donde corre n8n (sin protocolo, sin slash)
N8N_HOST=pedidai.es

# URL completa del editor de n8n (con protocolo y barra final; debe coincidir con N8N_PATH=/n8n/)
N8N_EDITOR_BASE_URL=https://pedidai.es/n8n/

# URL base para webhooks de n8n (con protocolo y barra final)
WEBHOOK_URL=https://pedidai.es/n8n/
